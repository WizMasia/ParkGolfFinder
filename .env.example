# ============================================
# ParkGolfFinder 환경변수 설정 가이드
# 이 파일을 .env.local에 복사하고 값을 채워서 사용
# ============================================

# 필수 - Prisma Postgres 데이터베이스 URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parkgolffinder"

# 필수 - Kakao Maps JavaScript SDK 키 (프론트엔드)
# 발급처: https://developers.kakao.com/ → 내 애플리케이션 → JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_API_KEY=""

# 선택 - Kakao REST API 키 (서버사이드 지오코딩/키워드 검색)
# 발급처: https://developers.kakao.com/ → 내 애플리케이션 → REST API 키
KAKAO_REST_API_KEY=""

# 선택 - V-World API 키 (지오코딩 fallback)
# 발급처: https://www.vworld.kr/ → 회원가입 → API 키 발급
VWORLD_API_KEY=""

# 선택 - 서울 열린데이터광장 API 키 (공공서비스예약)
# 발급처: https://data.seoul.go.kr/ → 회원가입 → 마이페이지 → API 인증키
SEOUL_OPENAPI_KEY=""

# 선택 - 경기데이터드림 API 키 (경기공유서비스 시설대관)
# 발급처: https://data.gg.go.kr/ → 회원가입 → 데이터 활용 → Open API 신청
GYEONGGI_OPENAPI_KEY=""

# 선택 - 수집 봇 실행 범위
BOT_SCOPE="national"

# 선택 - 수집 봇 staging 보관일
BOT_RETENTION_DAYS="7"

# 선택 - 수집 봇 동시 처리 수
BOT_CONCURRENCY="2"

# 선택 - 수집 봇 User-Agent
BOT_USER_AGENT="ParkGolfFinderBot/1.0"
